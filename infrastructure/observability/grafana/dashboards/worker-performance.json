          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (resilience4j_circuitbreaker_failure_rate{application=~\"$application\"}) >= 0",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
