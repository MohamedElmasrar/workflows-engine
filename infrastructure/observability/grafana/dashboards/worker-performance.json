          },
          "expr": "histogram_quantile(0.95, sum by (le, nodeType) (rate(worker_task_duration_seconds_bucket{application=~\"$application\"}[$__rate_interval])))",
          "legendFormat": "{{nodeType}}",
          "refId": "A",
          "range": true
