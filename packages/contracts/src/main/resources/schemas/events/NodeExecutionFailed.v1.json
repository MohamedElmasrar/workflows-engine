{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "NodeExecutionFailed", "type": "object",
  "required": ["executionId","nodeId","attemptId","workerId","error","durationMs","failedAt"],
  "properties": {
    "executionId": {"type":"string","format":"uuid"}, "nodeId": {"type":"string"},
    "attemptId": {"type":"string","format":"uuid"}, "workerId": {"type":"string"},
    "error": {"type":"object","required":["code","message","retryable"],
      "properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"}}},
    "durationMs": {"type":"integer","minimum":0}, "failedAt": {"type":"string","format":"date-time"} } }
