{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "WorkflowAccessUpdated", "type": "object",
  "required": ["workflowId","ownerId","aclRevision","entries","archived"],
  "properties": {
    "workflowId": {"type":"string","format":"uuid"}, "ownerId": {"type":"string","minLength":1},
    "aclRevision": {"type":"integer","minimum":0}, "archived": {"type":"boolean"},
    "entries": {"type":"array","items":{"type":"object","required":["userId","role"],
      "properties":{"userId":{"type":"string"},"role":{"enum":["OWNER","EDITOR","VIEWER"]}}}} } }
